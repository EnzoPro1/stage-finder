# Secrets — NE JAMAIS committer
.env
windows-ca-bundle.pem

# Environnement virtuel
.venv/

# Cache Python
__pycache__/
*.pyc

# Sorties générées
stages.csv
stages.html

# Artefacts de run — jamais versionnés.
# `stages.db` contient des offres scrapées : elle ne doit pas partir dans un
# clone. Ces motifs vivaient dans `.git/info/exclude`, qui n'est NI versionné
# NI cloné — il ne protégeait donc que cette copie de travail.
stages.db
# Journal WAL et mémoire partagée : `storage.ouvrir` pose `journal_mode=WAL`,
# qui fait apparaître ces deux fichiers À CÔTÉ de la base. Ils contiennent des
# pages de `stages.db` — donc des offres scrapées — et `stages.db` seul ne les
# couvre pas.
stages.db-wal
stages.db-shm
# Verrou inter-processus du worker (`worker.VerrouWorker`) : une base
# SQLite vide, dont seul le VERROU compte, plus son journal. Créés à côté
# de la base au premier démarrage du worker.
stages.db.worker-lock
stages.db.worker-lock-journal
# `avant-*` et non `avant-recalc-*` : le motif étroit ne couvrait que les
# sauvegardes de la migration des clés. La première sauvegarde nommée
# autrement (`stages.avant-replis-*.db`) est passée à travers et se serait
# retrouvée dans un commit. Toute sauvegarde de la base est ignorée, quel
# que soit le motif qui l'a produite.
stages.avant-*.db
.rank_cache.json
.rome_cache.json
.pytest_cache/

# Cache modèles HuggingFace (si local au projet)
.cache/
