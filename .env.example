# =====================================================================
#  Clés API pour job-finder
#  Copie ce fichier en ".env" puis remplis les valeurs.
#  Une clé absente => la source correspondante est simplement ignorée
#  (un warning est loggé, le programme ne plante pas).
# =====================================================================

# --- Adzuna ---  https://developer.adzuna.com/  (inscription gratuite)
#   Crée une "app", tu obtiens un App ID + une App Key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble ---  https://jooble.org/api/about  (clé gratuite sur demande)
JOOBLE_API_KEY=

# JobSpy (Indeed / LinkedIn / Google Jobs) ne nécessite AUCUNE clé :
# il fonctionne sans configuration ici.

# --- Careerjet ---  https://www.careerjet.fr/partners/  (facultatif)
#   Sans identifiant, la source utilise celui de démonstration de la doc,
#   partagé et donc soumis à un quota commun.
CAREERJET_AFFID=

# =====================================================================
#  LLM local (Ollama) — surcharges FACULTATIVES des défauts de config.py
#  Laisser vide = défaut. Réglages effectifs :  python -m llm
# =====================================================================
# SF_OLLAMA_URL=http://localhost:11434
# SF_LLM_MODEL=qwen3:4b
# SF_LLM_THINK=false
# SF_LLM_TEMPERATURE=0
# SF_LLM_NUM_CTX=8192
# SF_LLM_KEEP_ALIVE=10m          # "10m", "30s", nombre de secondes, -1 = indéfini
# SF_LLM_TOP_N=30                # offres envoyées au LLM après le pré-filtrage
# SF_LLM_TIMEOUT_S=180
# SF_LLM_NUM_PREDICT=500         # budget de tokens générés par réponse
# SF_LLM_NOUVELLES_TENTATIVES=2  # sortie JSON non conforme : nouvelles tentatives
# (Modèle d'embeddings : config.MODELE_EMBEDDING, « ollama:bge-m3 » pour Ollama.)

# =====================================================================
#  Chemins cv_forge (génération de CV) — surcharges FACULTATIVES
#  Chemins ABSOLUS. Défauts : config.CV_MASTER_PATH / config.CV_OUT_ROOT.
#  Entre apostrophes pour garder les antislashs tels quels.
# =====================================================================
# SF_CV_MASTER_PATH='C:\Users\toi\cv-forge\data\master.yaml'
# SF_CV_OUT_ROOT='C:\Users\toi\cv-forge\output\stages'
