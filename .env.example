# =====================================================================
#  Clés API pour job-finder
#  Copie ce fichier en ".env" puis remplis les valeurs.
#  Une clé absente => la source correspondante est simplement ignorée
#  (un warning est loggé, le programme ne plante pas).
# =====================================================================

# --- Adzuna ---  https://developer.adzuna.com/  (inscription gratuite)
#   Crée une "app", tu obtiens un App ID + une App Key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble ---  https://jooble.org/api/about  (clé gratuite sur demande)
JOOBLE_API_KEY=

# JobSpy (Indeed / LinkedIn / Google Jobs) ne nécessite AUCUNE clé :
# il fonctionne sans configuration ici.

# --- Careerjet ---  https://www.careerjet.fr/partners/  (facultatif)
#   Sans identifiant, la source utilise celui de démonstration de la doc,
#   partagé et donc soumis à un quota commun.
CAREERJET_AFFID=
